node_modules/
*.log

# Dados de runtime (banco, sessões WhatsApp, tenants)
data/*.db
data/tenants/
baileys-*/

# Ambiente / temporários
.env
.env.*
# Exceção: o modelo do banco de teste PRECISA ir para o git (a linha acima o pegaria).
!.env.test.example
.mcp.json
*.tmp

# Artefatos de validação visual (Playwright MCP)
.playwright-mcp/

# Rastro de eventos da sprintx/runx (local de quem executou, cresce rápido, sem merge)
docs/eventos/

# Agente de impressão (Electron) — artefatos de build
agente-impressora/dist/
agente-impressora/vendor/

# Protótipos (Claude Design): a FONTE são os .dc.html + canvas.json, que vão para o
# git. O .html publicado carrega o editor junto (~2,5 MB cada) e é regenerável a
# partir da fonte, então fica de fora para não inchar o repositório a cada revisão.
design/canvas/*.html
!design/canvas/*.dc.html

# Artefatos locais da toolchain de skills do Claude Code (task-observer/skill-creator):
# são meta-observação sobre as próprias skills, não conteúdo do projeto.
cross-cutting-principles.md
skill-observations/
